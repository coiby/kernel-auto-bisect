discover:
  - name: kab on a single machine (CRIU)
    how: fmf
    test:
     - /tests/kab_criu

provision:
   - name: client
     how: virtual
     connection: system

   - name: server
     how: virtual
     connection: system

prepare:
   - name: ensure kernel symlink for grubby
     how: shell
     script:
       - 'kver=$(uname -r)'
       - 'if [ ! -f /boot/vmlinuz-$kver ] && [ -f /lib/modules/$kver/vmlinuz ]; then ln -sf /lib/modules/$kver/vmlinuz /boot/vmlinuz-$kver; fi'

adjust:
    provision:
       - name: client
         how: connect
         guest: $@KAB_CLIENT_IP

       - name: server
         how: connect
         guest: $@KAB_SERVER_IP
    when: KAB_CLIENT_IP is defined and KAB_SERVER_IP is defined
