discover:
  - name: auto-transition RPM to source bisect on two machines
    how: fmf
    test:
     - /tests/kab_ssh_auto

provision:
   - name: client
     how: virtual
     connection: system

   - name: server
     how: virtual
     connection: system

prepare:
   - name: ensure kernel symlink for grubby
     how: shell
     script:
       - 'kver=$(uname -r)'
       - 'if [ ! -f /boot/vmlinuz-$kver ] && [ -f /lib/modules/$kver/vmlinuz ]; then ln -sf /lib/modules/$kver/vmlinuz /boot/vmlinuz-$kver; fi'

adjust:
    provision:
       - name: client
         how: connect
         guest: $@KAB_CLIENT_IP_AUTO

       - name: server
         how: connect
         guest: $@KAB_SERVER_IP_AUTO
    when: KAB_CLIENT_IP_AUTO is defined and KAB_SERVER_IP_AUTO is defined
